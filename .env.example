# Copy to .env.local and fill in.

# Server only — never exposed to the browser. Without it, every AI feature
# falls back to the deterministic simulation (scripted call, rules judge,
# built-in riddles), so the demo still runs.
GEMINI_API_KEY=

# "auto" (default): live Gemini voice when the server has a key, else simulation.
# "mock": always use the scripted call.
NEXT_PUBLIC_LIVE_PROVIDER=auto

# Optional model overrides (defaults in src/lib/gemini/models.ts).
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_ANALYST_MODEL=gemini-3.5-flash-lite
# GEMINI_JUDGE_MODEL=gemini-3.8-flash
# GEMINI_RIDDLE_MODEL=gemini-3.5-flash-lite
